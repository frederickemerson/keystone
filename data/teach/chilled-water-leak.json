            "part": "forbidden_actions",
            "text": "Re-energise on visual inspection alone"
          }
        },
        {
          "id": "open_cupboard",
          "label": "Open the riser cupboard to check if it is wet inside",
          "claim": "forbid:open_wet_cupboard",
          "means": {
            "part": "forbidden_actions",
            "text": "Open the electrical riser cupboard to check whether it is wet inside"
          }
        },
        {
          "id": "photograph",
          "label": "Photograph the standing water from outside the threshold",
          "claim": "forbid:photograph",
          "means": {
            "part": "forbidden_actions",
            "text": "Photograph standing water from outside the threshold"
          }
        },
        {
          "id": "cordon",
          "label": "Cordon the area and put up signage",
          "claim": "forbid:cordon",
          "means": {
            "part": "forbidden_actions",
            "text": "Cordon the area and put up signage"
          }
        }
      ]
