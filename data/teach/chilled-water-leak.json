    {
      "id": "q-deadline",
      "kind": "single_choice",
      "covers": "deadline_minutes",
      "probeId": "P20",
      "prompt": "A bank tenant floor is wet and the source is not isolated. How long before this stops being yours and has to go up?",
      "choices": [
