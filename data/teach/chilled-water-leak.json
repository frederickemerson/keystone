    {
      "id": "q-threshold",
      "kind": "single_choice",
      "covers": "trigger",
      "probeId": "P16",
      "refines": true,
      "prompt": "You said the water being near electrical equipment is what made this different. So where is the line? How close is too close?",
      "choices": [
        {
          "id": "0.5",
          "label": "Half a metre",
          "claim": "near_electrical:0.5m",
          "means": {
            "part": "trigger",
            "threshold": {
              "path": "evidence.distance_to_electrical_m",
              "op": "lte",
              "value": 0.5
            }
          }
        },
        {
          "id": "1",
          "label": "One metre",
          "claim": "near_electrical:1m",
          "means": {
            "part": "trigger",
            "threshold": {
              "path": "evidence.distance_to_electrical_m",
              "op": "lte",
              "value": 1
            }
          }
        },
        {
          "id": "2",
          "label": "Two metres",
          "claim": "near_electrical:2m",
          "note": "Water tracks along conduits and cable trays. You think it is two metres away and it is already at the board.",
          "means": {
            "part": "trigger",
            "threshold": {
              "path": "evidence.distance_to_electrical_m",
              "op": "lte",
              "value": 2
            }
          }
        },
        {
          "id": "5",
          "label": "Five metres",
          "claim": "near_electrical:5m",
          "means": {
            "part": "trigger",
            "threshold": {
              "path": "evidence.distance_to_electrical_m",
              "op": "lte",
              "value": 5
            }
          }
        },
        {
          "id": "contact",
          "label": "Only if it is actually touching",
          "claim": "near_electrical:contact",
          "means": {
            "part": "trigger",
            "threshold": {
              "path": "evidence.distance_to_electrical_m",
              "op": "lte",
              "value": 0
            }
          }
        }
      ]
    },
    {
      "id": "q-isolate-branch",
      "kind": "single_choice",
      "covers": "decision",
      "probeId": "P23",
      "refines": true,
      "given": "An AHU branch leak on Level 27. The branch sub-valve is accessible, and closing it stops the flow.",
