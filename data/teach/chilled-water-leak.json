{
  "pillId": "technical-services-chilled-water-leak",
  "scenarioId": "hf1-l28-coupling",
  "incidentType": "water_ingress",
  "ruleId": "TS-07",
  "opening": {
    "id": "q-account",
    "kind": "open",
    "covers": "trigger",
    "probeId": "P01",
    "prompt": "You are duty engineer. Walk me through what you do, and why — from the first moment you hear about it. Do not tidy it up; the order you actually did things in is the part I want.",
    "given": "02:14. A leak detector on Level 28 of Harbourfront One is in alarm. Water is coming through the ceiling void onto Level 27, a bank tenant floor, and it is tracking along a conduit toward the electrical riser cupboard. There is a distribution board in that cupboard, DB-27B."
  },
  "questions": [
    {
      "id": "q-isolate",
      "kind": "single_choice",
      "covers": "decision",
      "probeId": "P05",
      "prompt": "First call. What do you isolate?",
      "choices": [
        {
          "id": "riser",
          "label": "The whole riser",
          "claim": "isolate:riser",
          "note": "The valve you know will stop the flow.",
          "means": {
            "part": "decision",
            "text": "Isolate the whole chilled-water riser."
          }
        },
        {
          "id": "floor",
          "label": "The floor valve",
          "claim": "isolate:floor",
          "means": {
            "part": "decision",
            "text": "Isolate at the floor valve."
          }
        },
        {
          "id": "sub",
          "label": "The nearest sub-valve",
          "claim": "isolate:sub_valve",
          "note": "Smallest cut that stops it — if you can reach it and it holds.",
          "means": {
            "part": "decision",
            "text": "Isolate at the nearest branch sub-valve and leave the riser open."
          }
        },
        {
          "id": "trace",
          "label": "Nothing yet — trace the source first",
          "claim": "isolate:trace_first",
          "means": {
            "part": "decision",
            "text": "Trace the source before isolating anything."
          }
        }
      ]
    },
    {
      "id": "q-evidence",
      "kind": "multi_choice",
      "covers": "required_evidence",
      "probeId": "P15",
      "prompt": "The water is stopped and the AHU circuit is isolated. Before anyone re-energises it, what has to be confirmed? Pick everything that must be true.",
      "choices": [
        {
          "id": "lew_signoff",
          "label": "Written sign-off from a Licensed Electrical Worker",
          "claim": "ev:lew_signoff",
          "means": {
            "part": "required_evidence",
            "evidenceKey": "lew_signoff"
          }
        },
        {
          "id": "insulation_resistance_ok",
          "label": "Insulation resistance tested and passed",
          "claim": "ev:insulation_resistance_ok",
          "means": {
            "part": "required_evidence",
            "evidenceKey": "insulation_resistance_ok"
          }
        },
        {
          "id": "area_dry",
          "label": "The area confirmed dry",
          "claim": "ev:area_dry",
          "means": {
            "part": "required_evidence",
            "evidenceKey": "area_dry"
          }
        },
        {
          "id": "looks_dry",
          "label": "The board looks dry from outside the cupboard",
          "claim": "ev:visual_inspection",
          "means": {
            "part": "required_evidence",
            "evidenceKey": "visual_inspection"
          }
        },
        {
          "id": "tenant_told",
          "label": "The tenant has been told power is coming back",
          "claim": "ev:tenant_notified",
          "means": {
            "part": "required_evidence"
          }
        }
      ]
    },
    {
      "id": "q-who",
      "kind": "single_choice",
      "covers": "escalate_to",
      "probeId": "P19",
      "prompt": "Whose sign-off does the re-energisation need? Not who you would phone — whose name has to be on it.",
      "choices": [
        {
          "id": "duty_lew",
          "label": "The duty Licensed Electrical Worker",
          "claim": "signoff:duty_lew",
          "means": {
            "part": "escalate_to",
            "role": "duty_lew"
          }
        },
        {
          "id": "chief_engineer",
          "label": "The chief engineer",
          "claim": "signoff:chief_engineer",
          "means": {
            "part": "escalate_to",
            "role": "chief_engineer"
          }
        },
        {
          "id": "duty_manager",
          "label": "The duty manager",
          "claim": "signoff:duty_manager",
          "means": {
            "part": "escalate_to",
            "role": "duty_manager"
          }
        },
        {
          "id": "ts_lead",
          "label": "The technical services lead",
          "claim": "signoff:technical_services_lead",
          "means": {
            "part": "escalate_to",
            "role": "technical_services_lead"
          }
        }
      ]
    },
    {
